# --- Database ---
DATABASE_URL=postgresql+psycopg://aegis:aegis@postgres:5432/aegis

# --- Auth ---
# API key required in the `X-API-Key` header for all non-health endpoints.
# Single shared key by design (single-tenant internal tool, no user accounts).
AEGIS_API_KEY=change-me-dev-key
# Must match AEGIS_API_KEY above — inlined into the dashboard's client
# bundle (NEXT_PUBLIC_ vars are not secret; see lib/api.ts).
NEXT_PUBLIC_AEGIS_API_KEY=change-me-dev-key

# --- LLM provider (judge + reference assistant) ---
# LLM_PROVIDER selects which block below is actually used; the other can be
# left blank.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-haiku-4-5-20251001
ASSISTANT_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# --- Scheduler ---
# Two overlapping triggers: on-change (POST /webhooks/on-change, wired into
# the SUT's own deploy pipeline) and this fixed-interval background tick.
DEFAULT_SCHEDULE_INTERVAL_HOURS=6
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_SECONDS=300

# --- Calibration gate ---
CALIBRATION_AGREEMENT_THRESHOLD=0.9

# --- Reference assistant (system under test) ---
REFERENCE_ASSISTANT_URL=http://reference-assistant:8100
ENABLE_RETRIEVAL_BUG=false

# --- Alerting (optional outbound webhook, e.g. Slack-compatible) ---
ALERT_WEBHOOK_URL=

# --- CORS (dashboard origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
